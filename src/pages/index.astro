---
import Dot from '@/components/ui/Dot.astro'
import Hero from '@/components/ui/Hero.astro'
import BaseLayout from '@layouts/BaseLayout.astro'
---

<BaseLayout>
    <Hero class="hero--large" data-grid="fullbleed">
        <h1 class="hero__title" id="page-heading" tabindex="-1">
            roland<span aria-hidden="true">.</span>
        </h1>
        <div class="hero__explain flex letter-spacing" aria-hidden="true">
            <span>
                [
                <span class="ff-serif">
                    r<span class="underline">o</span>.land
                </span>
                ]
            </span>
            <Dot size="large" />
            <b>frontend developer</b>
        </div>
        <p class="hero__content">
            <i>Roland</i> is a frontend developer with a passion for creative coding and a sharp
            focus on CSS, HTML, and accessibility. I thrive on building web experiences that are not
            only visually appealing but accessible and performant for everyone.
        </p>
    </Hero>
</BaseLayout>

<style>
    @import '../css/global/functions.css';

    .hero__title {
        /* fix to align the title with text after it */
        margin-inline-start: -0.085ch;
        font-weight: var(--fw-semibold);
        font-size: round(down, --fluid-size(5rem, 16.25rem, 320px), 4px);
        white-space: nowrap;

        view-transition-name: none;

        > span {
            color: var(--color-primary-400);
        }
    }

    .hero__explain {
        --letter-spacing: 3;

        font-size: round(down, --fluid-size(1.25rem, 2.375rem), 2px);
    }

    .hero__content {
        font-size: round(down, --fluid-size(1.125rem, 1.75rem), 2px);
    }
</style>
