---
interface Props {
    class?: 'hero--large' | 'text-center' | 'hero--large text-center'
}

const { class: providedProps, ...rest } = Astro.props
---

<div class:list={['hero grid', providedProps]} {...rest}>
    <slot />
</div>

<style>
    @import '../../css/global/functions.css';

    div {
        --_size: 3rem;
        --_offset: calc(var(--_size) / 2);
        --_line: var(--highlight);

        position: relative;
        isolation: isolate;

        &::before,
        &::after {
            content: '';
            z-index: -1;
            inset: -6rem 0 0 0;
            pointer-events: none;
            position: absolute;
        }

        &::before {
            background-image:
                linear-gradient(90deg, var(--_line) 1px, transparent 1px var(--_size)),
                linear-gradient(var(--_line) 1px, transparent 1px var(--_size));
            background-position: var(--_offset) var(--_offset);
            background-size: var(--_size) var(--_size);
            background-attachment: fixed;
        }

        &::after {
            background-image: linear-gradient(to top left, var(--surface) 40%, transparent);
        }

        &.hero--large {
            align-content: center;
            row-gap: round(down, --fluid-size(1rem, 2rem), 4px);

            min-block-size: 90svb;
            padding-block-end: round(down, --fluid-size(3rem, 6rem), 4px);
        }

        > :global(:only-child) {
            align-content: end;
            max-inline-size: calc(var(--constrain-sm) + 3rem);
            padding-block: round(down, --fluid-size(3rem, 6rem), 4px);
        }
    }
</style>
